# ── RydeResolve LLM Configuration ──
#
# AGENT_MODE determines how agents reason:
#   deterministic — offline rule-based agents (default, no network, no LLM calls)
#   llm           — Rider Advocate, Driver Advocate and Judge call an OpenAI-compatible model
#
# Option A: WorkBuddy Cloud LLM (keyless, requires activating the cloud service):
#   1. Activate the WorkBuddy Cloud Service for this project (from WorkBuddy Desktop)
#   2. Start the LLM proxy: cd llm-proxy && npm install && npm start
#   3. Set AGENT_MODE=llm, LLM_BASE_URL=http://127.0.0.1:8877, LLM_MODEL=proxy
#   4. The proxy handles keyless auth via the WorkBuddy Cloud SDK
#
# Option B: Any OpenAI-compatible API (Tencent Hunyuan, DeepSeek, OpenAI, etc.):
#   Set LLM_BASE_URL, LLM_MODEL, LLM_API_KEY to your provider's values.
#
# Option C: Deterministic mode (offline):
#   Set AGENT_MODE=deterministic (default)

AGENT_MODE=deterministic

# anthropic uses the official Anthropic SDK (Messages API): LLM_BASE_URL=https://api.anthropic.com, LLM_MODEL=claude-opus-5-5,
#   LLM_API_KEY=<your Anthropic key>, LLM_MAX_OUTPUT_TOKENS=16000 (thinking counts toward it). Optional LLM_EFFORT=low|medium|high|xhigh|max.
# chat_completions works with OpenAI-compatible providers; responses is the OpenAI Responses API.
LLM_API_STYLE=chat_completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
# Set to json_object to request JSON mode on tool-free calls (Judge), if your provider supports it.
LLM_JSON_MODE=json_object

# Tencent Cloud examples (confirm model names in your console):
#   Hunyuan:                LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   LLM_MODEL=hunyuan-turbos-latest
#   DeepSeek on Tencent LKE: LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/v1     LLM_MODEL=deepseek-v3
#
# WorkBuddy Cloud LLM (via proxy):
#   LLM_BASE_URL=http://127.0.0.1:8877   LLM_MODEL=proxy   LLM_API_KEY=local-proxy-no-key-needed

# Deadline of an evidence-required window with no challenge:
#   finalize      -> the affected party did not meet the burden; the preliminary decision stands (default)
#   human_review  -> a reviewer decides instead
EVIDENCE_REQUIRED_TIMEOUT=finalize

ADMIN_TOKEN=
DEMO_CONTROLS=1
