# deterministic: offline rule-based agents (default, no network).
# llm: Rider Advocate, Driver Advocate and Judge call an OpenAI-compatible model.
AGENT_MODE=deterministic

# chat_completions works with OpenAI-compatible providers; responses is the OpenAI Responses API.
LLM_API_STYLE=chat_completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# Set to json_object to request JSON mode on tool-free calls (Judge), if your provider supports it.
LLM_JSON_MODE=

# Tencent Cloud examples (confirm model names in your console):
#   Hunyuan:                 LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   LLM_MODEL=hunyuan-turbos-latest
#   DeepSeek on Tencent LKE: LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/v1     LLM_MODEL=deepseek-v3

# Deadline of an evidence-required window with no challenge:
#   finalize      -> the affected party did not meet the burden; the preliminary decision stands (default)
#   human_review  -> a reviewer decides instead
EVIDENCE_REQUIRED_TIMEOUT=finalize

ADMIN_TOKEN=
DEMO_CONTROLS=1
